# Online Drive - Environment Configuration
# For Sirco deployment, set these as Environment Variables in the dashboard

# ===========================================
# REQUIRED FOR PRODUCTION
# ===========================================

# Session secret - REQUIRED for session persistence across restarts
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=530a5a2be59f8409d592712a3af0639c459f641b4219b3b44494d8666cefce3e

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Server port (Sirco uses 3000 by default)
PORT=3000

# Data directory - where database and files are stored
# Leave unset for ./data (relative to app root)
# DATA_DIR=./data

# Maximum upload size in MB (default: 1024 = 1GB)
MAX_UPLOAD_MB=1024

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# SIRCO DEPLOYMENT NOTES
# ===========================================
# 
# 1. Set SESSION_SECRET in Sirco's Environment tab
# 2. Use these Sirco settings:
#    - Runtime: Node.js (auto-detected)
#    - Install: npm install
#    - Build: npm run build  
#    - Start: npm start
#    - Port: 3000
#
# 3. For persistent storage, data is stored in ./data
#    Note: On Sirco free tier, data may not persist across deploys
#
# 4. Recommended: Set robots.txt to "Block All" in Sirco
#    to prevent uptime monitors from keeping service awake
